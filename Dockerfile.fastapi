FROM python:3.11-slim

# Install Node.js v16 and default-jdk (HotSpot JVM)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_16.x | bash - \
    && apt-get install -y --no-install-recommends \
    nodejs \
    gcc \
    g++ \
    default-jdk \
    mono-devel \
    mono-mcs \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy requirements first (for better caching)
COPY requirements-fastapi.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy executor service code (new refactored structure)
COPY executor-service/ /app/executor-service/

# Create non-root user (ACA requirement)
RUN useradd -m -u 1000 executor && \
    chown -R executor:executor /app

USER executor

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

# Run the service with Gunicorn + Uvicorn workers for FastAPI
# Use 4 workers with 2 threads each = 8 concurrent requests per replica
# With 2 replicas = 16 concurrent capacity, queue handles the rest
# Queue system: Gunicorn automatically queues requests beyond concurrent capacity
# This allows handling 500+ requests with proper queuing
CMD ["gunicorn", "executor-service.main:app", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "2", "--worker-class", "uvicorn.workers.UvicornWorker", "--timeout", "300", "--max-requests", "200", "--max-requests-jitter", "20", "--backlog", "200"]
